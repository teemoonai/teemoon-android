    {"name": "near-ai-tier-unknown", "pending": ["tier"], "ask": "stillChecking", "confirmReason": "pending"},
    {"name": "provenance-in-flight", "pending": ["provenance"], "ask": "provenancePending", "confirmReason": "provenancePending"},
