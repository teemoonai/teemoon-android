<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the launcher icon on the window ground, no branding image. -->
    <style name="Theme.Teemoon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
